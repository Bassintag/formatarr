{
  "name": "formatarr",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "zod": "4.6.7",
      "typescript": "7.0.2",
      "@types/bun": "1.4.5",
      "@orpc/contract": "2.0.0-beta.53",
      "@orpc/server": "2.0.0-beta.53",
      "@orpc/client": "2.0.0-beta.53",
      "@orpc/openapi": "2.0.0-beta.53",
      "@orpc/pino": "2.0.0-beta.53",
      "@orpc/publisher": "2.0.0-beta.53",
      "@orpc/tanstack-query": "2.0.0-beta.53"
    }
  },
  "scripts": {
    "dev": "FORCE_COLOR=1 bun run --parallel --filter '!@formatarr/worker' dev",
    "dev:worker": "bun run --filter @formatarr/worker dev",
    "build": "bun run --filter '*' build",
    "test": "bun test --parallel --no-isolate",
    "typecheck": "bun check --no-script",
    "check": "biome check . && bun run typecheck",
    "format": "biome check --write .",
    "db:generate": "bun run --filter @formatarr/api db:generate",
    "db:migrate": "bun run --filter @formatarr/api db:migrate",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "catalog:",
    "lefthook": "2.2.2",
    "typescript": "catalog:"
  }
}
